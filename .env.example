# Ask the tower (RAG chat) keys. Copy to .env for local scripts; set the same vars in Vercel for the live site.
# Generation (required): free key from https://console.groq.com
GROQ_API_KEY=
# Embeddings, option A (recommended, same as satyamkumarsingh.com): Cloudflare Workers AI, free tier.
# Dashboard: https://dash.cloudflare.com -> account id is in the URL; token: My Profile -> API Tokens -> Create -> Workers AI (Read).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Embeddings + generation fallback, option B: one free key from https://aistudio.google.com runs everything.
GEMINI_API_KEY=

# Contact form: Notify (https://github.com/Satyam087/notify), tenant `nimit`. The key comes from Satyam's
# `admin:create-api-key --tenant=nimit` run and is set once in Vercel; the site never exposes it.
NOTIFY_BASE_URL=https://notify-prod.onrender.com
NOTIFY_API_KEY=
